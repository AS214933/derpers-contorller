# Copy or generate deploy/.env; never commit real credentials.
IMAGE_VERSION=v0.2.0
# Optional full image references override IMAGE_VERSION, including @sha256 digests.
CONTROLLER_IMAGE=
AGENT_IMAGE=
DERPER_IMAGE=
POSTGRES_PASSWORD=
MASTER_KEY=
GRAFANA_ADMIN_PASSWORD=
METRICS_TOKEN=
CONTROLLER_URL=https://controller.example.com
PUBLIC_URL=https://controller.example.com
# Application proof authentication works through ordinary HTTP reverse proxies.
NODE_AUTH_MODE=proof
# Nginx origin only; bind a controlled origin IP and firewall to EdgeOne for production.
ORIGIN_BIND=127.0.0.1
ORIGIN_PORT=8080
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_GROUPS_CLAIM=groups
OIDC_SCOPES=openid,profile,email,groups
OIDC_ADMIN_GROUPS=derpers-admin
HEADSCALE_ALLOWED_CIDRS=
# Optional browser-accessible monitoring endpoints; empty hides external links.
GRAFANA_URL=
PROMETHEUS_URL=
# Required for DNS-01 provisioning. Use the staging directory for initial tests.
ACME_EMAIL=
ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory
