IMAGE_VERSION=v0.2.0
# Optional full Agent reference, including @sha256; match the controller's AGENT_IMAGE.
AGENT_IMAGE=
CONTROLLER_URL=https://controller.example.com
NODE_ID=
ENROLLMENT_TOKEN=
# Absolute host paths, matching the Agent's bind mounts.
HOST_CONFIG_DIR=/opt/derpers/node
HOST_STATE_DIR=/opt/derpers/agent-state
DOCKER_NETWORK=derpers-node
DERPER_CONTAINER=derpers-derper
CADDY_CONTAINER=derpers-caddy
# Leave CONTROLLER_CA_FILE empty for publicly trusted controller TLS.
# For a private controller CA copy it into TRUST_DIR and set /trust/controller-ca.crt.
TRUST_DIR=./secrets
CONTROLLER_CA_FILE=
